{% set ROMAN = ['I','II','III','IV','V','VI','VII','VIII','IX','X'] %}
{% set cvfile = root ~ 'cv/Yamen_Agha_CV_' ~ ('AR' if lang == 'ar' else 'EN') ~ '.pdf' %}
{% set arrow = '←' if dir == 'rtl' else '→' %}
<!doctype html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="author" content="Yamen Agha">
<meta name="theme-color" content="#F8F3E7">
<meta name="color-scheme" content="light">
<link rel="canonical" href="{{ site }}{% if lang == 'ar' %}ar/{% endif %}">
<link rel="alternate" hreflang="en" href="{{ site }}">
<link rel="alternate" hreflang="ar" href="{{ site }}ar/">
<link rel="alternate" hreflang="x-default" href="{{ site }}">
<meta property="og:type" content="profile">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site }}{% if lang == 'ar' %}ar/{% endif %}">
<meta property="og:image" content="{{ site }}assets/img/og.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Yamen Agha — engraved banknote portrait">
<meta property="og:locale" content="{{ og_locale }}">
<meta property="og:locale:alternate" content="{{ og_alt }}">
<meta property="profile:first_name" content="Yamen">
<meta property="profile:last_name" content="Agha">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site }}assets/img/og.jpg">
<link rel="icon" href="{{ root }}favicon.ico" sizes="48x48">
<link rel="icon" href="{{ root }}assets/img/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="{{ root }}assets/img/icon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="{{ root }}assets/img/apple-touch-icon.png">
<link rel="manifest" href="{{ root }}site.webmanifest">
<link rel="preload" href="{{ root }}assets/fonts/EBGaramond-normal-500-latin.woff2" as="font" type="font/woff2" crossorigin>
{% if lang == 'ar' %}<link rel="preload" href="{{ root }}assets/fonts/IBMPlexSansArabic-normal-400-arabic.woff2" as="font" type="font/woff2" crossorigin>{% endif %}
<link rel="preload" as="image" href="{{ root }}assets/img/portrait-engraved.webp" imagesrcset="{{ root }}assets/img/portrait-engraved-640.webp 640w, {{ root }}assets/img/portrait-engraved.webp 1008w" imagesizes="(max-width: 760px) 330px, 500px">
<link rel="stylesheet" href="{{ root }}assets/css/fonts.css">
<link rel="stylesheet" href="{{ root }}assets/css/style.css">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Person","name":"Yamen Agha","alternateName":"{{ name_full }}","url":"{{ site }}","image":"{{ site }}assets/img/og.jpg","email":"mailto:{{ email }}","telephone":"{{ phone_tel }}","jobTitle":"DSE-trained broker candidate","address":{"@type":"PostalAddress","addressLocality":"Aleppo","addressCountry":"SY"},"alumniOf":{"@type":"CollegeOrUniversity","name":"Aleppo University"},"knowsLanguage":["ar","en","ru"],"sameAs":["{{ linkedin }}","{{ github }}"]}
</script>
</head>
<body class="lang-{{ lang }}">
<a class="skip" href="#main">{{ skip }}</a>
<div class="sheet">
<div class="topbar"><span>Yamen Agha · {{ topbar }}</span><span class="topbar__est">{{ est }}</span><a class="topbar__lang" href="{{ alt_href }}" hreflang="{{ alt_lang }}" lang="{{ alt_lang }}">{{ alt_label }}</a></div>
<header class="mast" id="top">
  <nav class="nav nav--start" aria-label="Primary">
    {% for href, label in nav4[:2] %}<a href="{{ href }}">{{ label }}</a>{% endfor %}
  </nav>
  <a class="mast__crest" href="#top" aria-label="Yamen Agha — home"><img src="{{ root }}assets/img/crest.webp" width="104" height="104" alt=""></a>
  <nav class="nav nav--end" aria-label="Primary, continued">
    <a href="{{ cvfile }}" download>{{ nav4[2][1] }}</a><a href="{{ nav4[3][0] }}">{{ nav4[3][1] }}</a>
  </nav>
</header>
<div class="rule2" aria-hidden="true"></div>

<main id="main">
<section class="hero" aria-labelledby="hero-title">
  <h1 class="sr-only" id="hero-title">{{ h1 }}</h1>
  <div class="hero__start">
    <p class="sc">{{ kicker }}</p>
    <p class="hero__role">{{ hero_role }}</p>
    <p class="hero__lede">{{ hero_lede }}</p>
    <div class="btns">
      <a class="btn btn--ink" href="{{ cvfile }}" download>{{ cta_cv }} <span aria-hidden="true">↓</span></a>
      <a class="btn btn--line" href="#contact">{{ cta_contact }} <span aria-hidden="true">{{ arrow }}</span></a>
    </div>
  </div>
  <div class="stage" aria-hidden="true">
    <img class="stage__oval" src="{{ root }}assets/img/guil-oval.webp" width="600" height="800" alt="" decoding="async">
    <span class="name name--back">YAMEN</span>
    <img class="stage__fig" src="{{ root }}assets/img/portrait-engraved.webp" srcset="{{ root }}assets/img/portrait-engraved-640.webp 640w, {{ root }}assets/img/portrait-engraved.webp 1008w" sizes="(max-width: 760px) 330px, 500px" width="1008" height="1792" alt="" fetchpriority="high" decoding="async">
    <span class="name name--front">AGHA</span>
  </div>
  <dl class="hero__end">
    {% for k, v in facts %}<div><dt>{{ k }}</dt><dd>{{ v }}</dd></div>{% endfor %}
    <div><dt>{{ facts3[0] }}</dt><dd>{{ facts3[1] }}</dd></div>
  </dl>
</section>

{% macro divider() %}<div class="divider" aria-hidden="true"><i></i><img src="{{ root }}assets/img/crest-ink.webp" width="64" height="64" alt="" loading="lazy"><i></i></div>{% endmacro %}
{% macro head(no, label, title) %}
<header class="sec-head">
  <p class="sc">§ {{ no }} · {{ label }}</p>
  <h2>{{ title | safe }}</h2>
</header>
{% endmacro %}
{% macro seal() %}<img class="seal" src="{{ root }}assets/img/seal-wax.webp" width="104" height="104" alt="" loading="lazy">{% endmacro %}

{{ divider() }}
<section class="sec about" id="about">
  {{ head(about_no, about_label, about_title) }}
  <div class="about__grid">
    <div class="about__text">
      <p class="about__lead">{{ about_lead }}</p>
      <p>{{ about_body }}</p>
    </div>
    <dl class="ledger">
      {% for k, v in about_facts %}<div><dt>{{ k }}</dt><dd>{{ v }}</dd></div>{% endfor %}
    </dl>
  </div>
</section>

{{ divider() }}
<section class="sec exp" id="experience">
  {{ head(exp_no, exp_label, exp_title) }}
  <ol class="exp__list">
    {% for e in experience %}
    <li class="exp__item">
      <span class="exp__num" aria-hidden="true">{{ ROMAN[loop.index0] }}</span>
      <div class="exp__head">
        <h3>{{ e.org }}</h3>
        <p class="exp__role">{{ e.role }}</p>
        <p class="exp__when">{{ e.date }}{% if e.place %} · {{ e.place }}{% endif %}</p>
      </div>
      <ul class="exp__bullets">{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    </li>
    {% endfor %}
  </ol>
</section>

{{ divider() }}
<section class="sec work" id="work">
  {{ head(work_no, work_label, work_title) }}
  <p class="sec-intro">{{ work_intro }}</p>
  <div class="certs">
    {% for a in apps_list %}{% set t = apps[a.key] %}
    <article class="cert{% if loop.first %} cert--wide{% endif %}">
      <div class="cert__in">
        <div class="cert__top"><span class="serial">{{ serial }} YA·2026·{{ '%04d' % loop.index }}</span><span class="sc">{{ t[1] }}</span><span class="serial serial--2" aria-hidden="true">{{ serial }} YA·2026·{{ '%04d' % loop.index }}</span></div>
        <p class="cert__no" aria-hidden="true">{{ ROMAN[loop.index0] }}</p>
        <h3>{{ t[0] }}</h3>
        <div class="cert__body">
          <a class="cert__shot" href="{{ a.live }}" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><img src="{{ root }}assets/img/{{ a.img }}" width="1200" height="750" alt="" loading="lazy" decoding="async"></a>
          <div class="cert__copy">
            <p class="cert__text">{{ t[2] }}</p>
            <p class="tags">{% for g in t[3] %}<span>{{ g }}</span>{% endfor %}</p>
            <div class="cert__foot">
              <div class="btns">
                <a class="btn btn--ink" href="{{ a.live }}" target="_blank" rel="noopener">{{ live }} <span aria-hidden="true">↗</span><span class="sr-only"> — {{ t[0] }}</span></a>
                <a class="btn btn--line" href="{{ a.code }}" target="_blank" rel="noopener">{{ code }} <span aria-hidden="true">↗</span><span class="sr-only"> — {{ t[0] }}</span></a>
              </div>
              {{ seal() }}
            </div>
          </div>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>

  <div class="panel excel">
    <p class="sc">{{ excel_title }}</p>
    <ol>{% for x in excel_items %}<li>{{ x }}</li>{% endfor %}</ol>
    <a class="btn btn--line" href="{{ portfolio_repo }}/tree/main/finance" target="_blank" rel="noopener">{{ excel_link }} <span aria-hidden="true">↗</span></a>
  </div>

  <div class="cases" id="case-studies">
    <p class="sc c">{{ cases_label }}</p>
    <h3 class="cases__title">{{ cases_title|safe }}</h3>
    <p class="sec-intro">{{ cases_intro }}</p>
    <div class="certs certs--cases">
      {% for c in cases %}
      <article class="cert cert--case">
        <div class="cert__in">
          <div class="cert__top"><span class="serial">{{ serial }} CS·{{ '%03d' % loop.index }}</span><span class="sc">{{ c.kind }}</span><span class="serial serial--2" aria-hidden="true">{{ c.n }} {{ pages }}</span></div>
          <h4>{{ c.title }}</h4>
          <p class="cert__text">{{ c.text }}</p>
          <p class="tags">{% for g in c.tags %}<span>{{ g }}</span>{% endfor %}</p>
          <div class="btns">
            <a class="btn btn--ink" href="{{ root }}{{ c.pdf }}" target="_blank" rel="noopener">{{ report }} · PDF <span aria-hidden="true">↓</span><span class="sr-only"> — {{ c.title }}, {{ c.n }} {{ pages }}</span></a>
            {% if c.xlsx %}<a class="btn btn--line" href="{{ root }}{{ c.xlsx }}" download>{{ model }} <span aria-hidden="true">↓</span><span class="sr-only"> — {{ c.title }}</span></a>{% endif %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{{ divider() }}
<section class="sec systems" id="systems">
  {{ head(sys_no, sys_label, sys_title) }}
  <p class="sec-intro">{{ sys_intro }}</p>
  {% for s in systems %}
  <article class="cert cert--sys">
    <div class="cert__in">
      <div class="cert__top"><span class="serial">{{ serial }} YA·CLUB·{{ '%02d' % loop.index }}</span><span class="sc">{{ s.kind }}</span><span class="serial serial--2" aria-hidden="true">{{ serial }} YA·CLUB·{{ '%02d' % loop.index }}</span></div>
      <div class="sys">
        <div class="sys__phones">
          {% for src, alt in s.imgs %}<figure class="phone"><img src="{{ root }}assets/img/{{ src }}" width="600" height="1298" alt="{{ alt }}" loading="lazy" decoding="async"></figure>{% endfor %}
        </div>
        <div class="sys__text">
          <h3>{{ s.name }}</h3>
          <p class="cert__text">{{ s.text }}</p>
          <ul class="sys__points">{% for p in s.points %}<li>{{ p }}</li>{% endfor %}</ul>
          <p class="sys__tech">{{ s.tech }}</p>
          <div class="cert__foot">
            <div class="btns">
              {% if s.link %}<a class="btn btn--ink" href="{{ s.link[1] }}" target="_blank" rel="noopener">{{ s.link[0] }} <span aria-hidden="true">↗</span></a>{% endif %}
              <span class="pill">{{ s.private }}</span>
            </div>
            {{ seal() }}
          </div>
        </div>
      </div>
    </div>
  </article>
  {% endfor %}
</section>

{{ divider() }}
<section class="sec skills" id="skills">
  {{ head(skills_no, skills_label, skills_title) }}
  <div class="skills__grid">
    {% for group, items in skills %}
    <div class="skill"><p class="skill__no" aria-hidden="true">{{ ROMAN[loop.index0] }}</p><h3>{{ group }}</h3><ul>{% for i in items %}<li>{{ i }}</li>{% endfor %}</ul></div>
    {% endfor %}
  </div>
</section>

{{ divider() }}
<section class="sec edu" id="education">
  {{ head(edu_no, edu_label, edu_school) }}
  <div class="edu__grid">
    <div class="panel">
      <p class="edu__degree">{{ edu_degree }}</p>
      <p class="edu__meta">{{ edu_year }} · {{ edu_place }} · {{ edu_grad_label }} {{ edu_grad }}</p>
      <p class="sc">{{ edu_course_label }}</p>
      <p class="tags tags--lg">{% for c in courses %}<span>{{ c }}</span>{% endfor %}</p>
    </div>
    <div class="panel">
      <p class="sc">{{ lang_title }}</p>
      <ul class="langs">
        {% for script, name, level, pct, code in languages %}
        <li><span class="langs__script" lang="{{ code }}">{{ script }}</span><span class="langs__name">{{ name }}</span><span class="langs__level">{{ level }}</span></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="contact" id="contact">
  <div class="letter">
    <div class="letter__band" aria-hidden="true"></div>
    <img class="letter__crest" src="{{ root }}assets/img/crest.webp" width="110" height="110" alt="" loading="lazy">
    <p class="sc">§ {{ contact_no }} · {{ contact_kicker }}</p>
    <h2>{{ contact_title|safe }}</h2>
    <p class="letter__text">{{ contact_text }} {{ letter_close }}</p>
    <a class="letter__email" href="mailto:{{ email }}" dir="ltr">{{ email }}</a>
    <div class="btns btns--c">
      <a class="btn btn--ink" href="mailto:{{ email }}">{{ contact_rows[0][0] }} <span aria-hidden="true">✉</span></a>
      <a class="btn btn--line" href="{{ linkedin }}" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="btn btn--line" href="{{ github }}" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
    </div>
    <div class="btns btns--c">
      <a class="btn btn--line" href="{{ root }}cv/Yamen_Agha_CV_EN.pdf" download>{{ cv_en }} <span aria-hidden="true">↓</span></a>
      <a class="btn btn--line" href="{{ root }}cv/Yamen_Agha_CV_AR.pdf" download>{{ cv_ar }} <span aria-hidden="true">↓</span></a>
    </div>
    <dl class="letter__rows">
      {% for k, v, href in contact_rows %}<div><dt>{{ k }}</dt><dd>{% if href %}<a href="{{ href }}"{% if href.startswith('http') %} target="_blank" rel="noopener"{% endif %} dir="ltr">{{ v }}</a>{% else %}{{ v }}{% endif %}</dd></div>{% endfor %}
    </dl>
    <p class="sig" dir="ltr">{{ sign }}</p>
    <div class="letter__band" aria-hidden="true"></div>
  </div>
</section>
</main>

<footer class="foot">
  <span>© {{ year }} Yamen Agha · {{ edu_place }}</span>
  <span>{{ footer_note }}</span>
  <a href="#top">{{ back_top }} ↑</a>
</footer>
</div>
</body>
</html>
